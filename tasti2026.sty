\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tasti2026}[2026/08/06 v0.1 TASTI 2026 extended abstract style]

% ---------------------------------------------------------------------------
% Reproduces the formatting requirements of
% "TASTI 2026_Abstract_Template_0410.docx" (see template/ for the PDF):
%   - Paper size: A4, single column
%   - Margins: top/bottom 2.54 cm, left/right 3.17 cm
%   - Font: Times New Roman, 10.5 pt, single line spacing
%   - Paragraphs separated by a blank line, no indentation
%   - Title: title case, bold, centered
%   - Affiliations / presenter email: italic, centered (email underlined)
%   - Footer: "TASTI-2026"
% ---------------------------------------------------------------------------

\RequirePackage[a4paper,top=2.54cm,bottom=2.54cm,left=3.17cm,right=3.17cm]{geometry}
\RequirePackage[T1]{fontenc}
% Times-compatible text/math fonts for pdfLaTeX. If the genuine Times New
% Roman face is required, compile with XeLaTeX/LuaLaTeX and replace the two
% lines below with: \RequirePackage{fontspec}\setmainfont{Times New Roman}
\RequirePackage{newtxtext}
\RequirePackage{newtxmath}
\RequirePackage{graphicx}
\RequirePackage{fancyhdr}

% 10.5 pt body font on a single-spaced (1.2x) baseline
\renewcommand{\normalsize}{\@setfontsize\normalsize{10.5}{12.6}}
\normalsize

% Paragraphs: one blank line between, no indent
\setlength{\parindent}{0pt}
\setlength{\parskip}{\baselineskip}

% Footer "TASTI-2026" on every page, no rules
\fancyhf{}
\fancyfoot[L]{TASTI-2026}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\pagestyle{fancy}

% ---------------------------------------------------------------------------
% Title-block commands
% ---------------------------------------------------------------------------

% Superscript affiliation marker: \affmark{1,2} -> ^{1,2)}
% Presenting author: put * first, e.g. Feng Hwang\affmark{*,1,2}
\newcommand{\affmark}[1]{\textsuperscript{#1)}}

% Title: bold, centered. 14 pt is an eyeball match to the template sample
% (the guideline only mandates "bold, centered"); adjust if the docx differs.
\newcommand{\abstracttitle}[1]{%
  \begin{center}%
    \fontsize{14}{16.8}\selectfont\bfseries #1%
  \end{center}\vspace{-\parskip}}

% Author list: full first + last names, comma separated, centered
\newcommand{\abstractauthors}[1]{%
  \begin{center}#1\end{center}\vspace{-\parskip}}

% Affiliation line(s): italic, centered, organization + country only
\newcommand{\abstractaffil}[1]{%
  \begin{center}\itshape #1\end{center}\vspace{-\parskip}}

% Presenting author's email: italic, underlined, centered
\newcommand{\abstractemail}[1]{%
  \begin{center}\itshape\underline{#1}\end{center}\vspace{-\parskip}}

% Keyword line: "keywords" in bold, max 5 keywords
\newcommand{\abstractkeywords}[1]{%
  \begin{center}\textbf{keywords}: #1\end{center}}

\endinput
